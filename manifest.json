// ----------------------------------------------------
// 1. 단어장 목록 화면 (베이지 톤 + 중앙 그린 버튼)
// ----------------------------------------------------
class BookListScreen extends StatefulWidget {
  const BookListScreen({super.key});

  @override
  State<BookListScreen> createState() => _BookListScreenState();
}

class _BookListScreenState extends State<BookListScreen> {
  List<Map<String, dynamic>> _books = [];
  bool _isLoading = true;

  @override
  void initState() {
    super.initState();
    _fetchBooks();
  }

  Future<void> _fetchBooks() async {
    setState(() => _isLoading = true);
    try {
      final data = await supabase
          .from('vocab_books')
          .select()
          .order('id', ascending: false);
      setState(() {
        _books = List<Map<String, dynamic>>.from(data);
      });
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('단어장 불러오기 실패: $e'),
            backgroundColor: Colors.redAccent,
          ),
        );
      }
    } finally {
      if (mounted) setState(() => _isLoading = false);
    }
  }

  Future<void> _createBook(String title) async {
    if (title.trim().isEmpty) return;
    try {
      await supabase.from('vocab_books').insert({'title': title.trim()});
      _fetchBooks();
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('생성 실패: $e')),
        );
      }
    }
  }

  Future<void> _deleteBook(int bookId, String title) async {
    final confirm = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        backgroundColor: Colors.white,
        title: const Text('단어장 삭제'),
        content: Text('\'$title\' 단어장과 포함된 모든 단어를 삭제하시겠습니까?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx, false),
            child: const Text('취소', style: TextStyle(color: Colors.grey)),
          ),
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: Colors.redAccent),
            onPressed: () => Navigator.pop(ctx, true),
            child: const Text('삭제', style: TextStyle(color: Colors.white)),
          ),
        ],
      ),
    );

    if (confirm != true) return;

    try {
      await supabase.from('words').delete().eq('book_id', bookId);
      await supabase.from('vocab_books').delete().eq('id', bookId);

      _fetchBooks();
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('단어장이 삭제되었습니다.')),
        );
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('삭제 실패: $e')),
        );
      }
    }
  }

  void _showAddBookDialog() {
    final controller = TextEditingController();
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        backgroundColor: Colors.white,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        title: const Text('새 단어장 추가', style: TextStyle(fontWeight: FontWeight.bold)),
        content: TextField(
          controller: controller,
          decoration: InputDecoration(
            hintText: '단어장 이름 (예: 토익, 수능, 일상 영어)',
            filled: true,
            fillColor: const Color(0xFFF7F5F0),
            border: OutlineInputBorder(
              borderRadius: BorderRadius.circular(12),
              borderSide: BorderSide.none,
            ),
          ),
          autofocus: true,
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: const Text('취소', style: TextStyle(color: Colors.grey)),
          ),
          ElevatedButton(
            style: ElevatedButton.styleFrom(
              backgroundColor: const Color(0xFF2E7D32),
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
            ),
            onPressed: () {
              Navigator.pop(ctx);
              _createBook(controller.text);
            },
            child: const Text('생성', style: TextStyle(color: Colors.white)),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Word World'), // 띄어쓰기 및 초록 타이틀 반영
        centerTitle: true,
      ),
      body: _isLoading
          ? const Center(child: CircularProgressIndicator(color: Color(0xFF2E7D32)))
          : _books.isEmpty
              ? Center(
                  child: Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 32.0),
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        const Text(
                          '여기에 단어장을 만들고\n나만의 어휘력을 쑥쑥 키워보세요.',
                          textAlign: TextAlign.center,
                          style: TextStyle(
                            color: Color(0xFF78716C),
                            fontSize: 16,
                            height: 1.5,
                          ),
                        ),
                        const SizedBox(height: 24),
                        // 중앙의 아담하고 깔끔한 초록색 버튼
                        ElevatedButton.icon(
                          style: ElevatedButton.styleFrom(
                            backgroundColor: const Color(0xFF2E7D32),
                            foregroundColor: Colors.white,
                            padding: const EdgeInsets.symmetric(
                              horizontal: 24,
                              vertical: 14,
                            ),
                            shape: RoundedRectangleBorder(
                              borderRadius: BorderRadius.circular(16),
                            ),
                            elevation: 2,
                          ),
                          onPressed: _showAddBookDialog,
                          icon: const Icon(Icons.add, size: 20),
                          label: const Text(
                            '새로운 단어장',
                            style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
                          ),
                        ),
                      ],
                    ),
                  ),
                )
              : ListView.builder(
                  padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                  itemCount: _books.length,
                  itemBuilder: (context, index) {
                    final book = _books[index];
                    return Card(
                      color: Colors.white,
                      elevation: 1.5,
                      shadowColor: Colors.black12,
                      margin: const EdgeInsets.symmetric(vertical: 6),
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(16),
                      ),
                      child: ListTile(
                        contentPadding: const EdgeInsets.symmetric(
                            horizontal: 18, vertical: 8),
                        leading: CircleAvatar(
                          backgroundColor: const Color(0xFFE8F5E9),
                          child: const Icon(Icons.menu_book, color: Color(0xFF2E7D32)),
                        ),
                        title: Text(
                          book['title'] ?? '이름 없음',
                          style: const TextStyle(
                            fontSize: 17,
                            fontWeight: FontWeight.w600,
                            color: Color(0xFF292524),
                          ),
                        ),
                        trailing: Row(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            IconButton(
                              icon: const Icon(Icons.delete_outline, color: Colors.redAccent),
                              onPressed: () => _deleteBook(book['id'], book['title'] ?? ''),
                            ),
                            const Icon(Icons.chevron_right, color: Color(0xFFA8A29E)),
                          ],
                        ),
                        onTap: () {
                          Navigator.push(
                            context,
                            MaterialPageRoute(
                              builder: (_) => DayListScreen(
                                bookId: book['id'],
                                bookTitle: book['title'] ?? '',
                              ),
                            ),
                          );
                        },
                      ),
                    );
                  },
                ),
      floatingActionButton: _books.isNotEmpty
          ? FloatingActionButton.extended(
              onPressed: _showAddBookDialog,
              backgroundColor: const Color(0xFF2E7D32),
              foregroundColor: Colors.white,
              icon: const Icon(Icons.add),
              label: const Text('새로운 단어장', style: TextStyle(fontWeight: FontWeight.bold)),
            )
          : null,
    );
  }
}

// ----------------------------------------------------
// 2. Day 목록 화면
// ----------------------------------------------------
class DayListScreen extends StatefulWidget {
  final int bookId;
  final String bookTitle;

  const DayListScreen({
    super.key,
    required this.bookId,
    required this.bookTitle,
  });

  @override
  State<DayListScreen> createState() => _DayListScreenState();
}

class _DayListScreenState extends State<DayListScreen> {
  List<int> _days = [];
  bool _isLoading = true;

  @override
  void initState() {
    super.initState();
    _fetchDays();
  }

  Future<void> _fetchDays() async {
    setState(() => _isLoading = true);
    try {
      final data = await supabase
          .from('words')
          .select('day')
          .eq('book_id', widget.bookId);

      final daySet = <int>{};
      for (var row in data) {
        if (row['day'] != null) {
          daySet.add(row['day'] as int);
        }
      }
      final sortedDays = daySet.toList()..sort();

      setState(() {
        _days = sortedDays;
      });
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Day 목록 불러오기 실패: $e')),
        );
      }
    } finally {
      if (mounted) setState(() => _isLoading = false);
    }
  }

  void _showAddDayDialog() {
    final nextDay = _days.isEmpty ? 1 : _days.last + 1;
    final controller = TextEditingController(text: '$nextDay');

    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        backgroundColor: Colors.white,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        title: const Text('Day 추가', style: TextStyle(fontWeight: FontWeight.bold)),
        content: TextField(
          controller: controller,
          keyboardType: TextInputType.number,
          decoration: InputDecoration(
            labelText: '추가할 Day 번호',
            filled: true,
            fillColor: const Color(0xFFF7F5F0),
            border: OutlineInputBorder(
              borderRadius: BorderRadius.circular(12),
              borderSide: BorderSide.none,
            ),
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: const Text('취소', style: TextStyle(color: Colors.grey)),
          ),
          ElevatedButton(
            style: ElevatedButton.styleFrom(
              backgroundColor: const Color(0xFF2E7D32),
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
            ),
            onPressed: () {
              final parsed = int.tryParse(controller.text);
              Navigator.pop(ctx);
              if (parsed != null) {
                Navigator.push(
                  context,
                  MaterialPageRoute(
                    builder: (_) => WordListScreen(
                      bookId: widget.bookId,
                      bookTitle: widget.bookTitle,
                      day: parsed,
                    ),
                  ),
                ).then((_) => _fetchDays());
              }
            },
            child: const Text('확인', style: TextStyle(color: Colors.white)),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(widget.bookTitle),
      ),
      body: _isLoading
          ? const Center(child: CircularProgressIndicator(color: Color(0xFF2E7D32)))
          : _days.isEmpty
              ? Center(
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      const Text(
                        '아직 등록된 Day가 없습니다.',
                        style: TextStyle(color: Color(0xFF78716C), fontSize: 16),
                      ),
                      const SizedBox(height: 20),
                      ElevatedButton.icon(
                        style: ElevatedButton.styleFrom(
                          backgroundColor: const Color(0xFF2E7D32),
                          foregroundColor: Colors.white,
                          padding: const EdgeInsets.symmetric(horizontal: 22, vertical: 14),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(16),
                          ),
                          elevation: 2,
                        ),
                        onPressed: _showAddDayDialog,
                        icon: const Icon(Icons.add),
                        label: const Text(
                          'Day 1 시작하기',
                          style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
                        ),
                      )
                    ],
                  ),
                )
              : ListView.builder(
                  padding: const EdgeInsets.all(16),
                  itemCount: _days.length,
                  itemBuilder: (context, index) {
                    final dayNum = _days[index];
                    return Card(
                      color: Colors.white,
                      elevation: 1.5,
                      shadowColor: Colors.black12,
                      margin: const EdgeInsets.symmetric(vertical: 6),
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(16),
                      ),
                      child: ListTile(
                        leading: CircleAvatar(
                          backgroundColor: const Color(0xFFE8F5E9),
                          child: Text(
                            '$dayNum',
                            style: const TextStyle(
                              fontWeight: FontWeight.bold,
                              color: Color(0xFF2E7D32),
                            ),
                          ),
                        ),
                        title: Text(
                          'Day $dayNum',
                          style: const TextStyle(
                            fontSize: 17,
                            fontWeight: FontWeight.w600,
                            color: Color(0xFF292524),
                          ),
                        ),
                        trailing: const Icon(Icons.chevron_right, color: Color(0xFFA8A29E)),
                        onTap: () {
                          Navigator.push(
                            context,
                            MaterialPageRoute(
                              builder: (_) => WordListScreen(
                                bookId: widget.bookId,
                                bookTitle: widget.bookTitle,
                                day: dayNum,
                              ),
                            ),
                          ).then((_) => _fetchDays());
                        },
                      ),
                    );
                  },
                ),
      floatingActionButton: _days.isNotEmpty
          ? FloatingActionButton(
              onPressed: _showAddDayDialog,
              backgroundColor: const Color(0xFF2E7D32),
              foregroundColor: Colors.white,
              child: const Icon(Icons.add),
            )
          : null,
    );
  }
}

// ----------------------------------------------------
// 3. 단어 목록 화면 (초록 단어 추가 버튼 및 다이얼로그)
// ----------------------------------------------------
class WordListScreen extends StatefulWidget {
  final int bookId;
  final String bookTitle;
  final int day;

  const WordListScreen({
    super.key,
    required this.bookId,
    required this.bookTitle,
    required this.day,
  });

  @override
  State<WordListScreen> createState() => _WordListScreenState();
}

class _WordListScreenState extends State<WordListScreen> {
  List<Map<String, dynamic>> _words = [];
  bool _isLoading = true;

  @override
  void initState() {
    super.initState();
    _fetchWords();
  }

  Future<void> _fetchWords() async {
    setState(() => _isLoading = true);
    try {
      final data = await supabase
          .from('words')
          .select()
          .eq('book_id', widget.bookId)
          .eq('day', widget.day)
          .order('id', ascending: true);

      setState(() {
        _words = List<Map<String, dynamic>>.from(data);
      });
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('단어 로딩 실패: $e')),
        );
      }
    } finally {
      if (mounted) setState(() => _isLoading = false);
    }
  }

  void _showAddWordDialog() {
    final wordController = TextEditingController();
    final meaningController = TextEditingController();

    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        backgroundColor: Colors.white,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        title: Text(
          'Day ${widget.day} 단어 추가',
          style: const TextStyle(fontWeight: FontWeight.bold),
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            TextField(
              controller: wordController,
              autofocus: true,
              decoration: InputDecoration(
                labelText: '영어 단어',
                hintText: '예: challenge',
                filled: true,
                fillColor: const Color(0xFFF7F5F0),
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(12),
                  borderSide: BorderSide.none,
                ),
              ),
            ),
            const SizedBox(height: 12),
            TextField(
              controller: meaningController,
              decoration: InputDecoration(
                labelText: '한국어 뜻',
                hintText: '예: 도전',
                filled: true,
                fillColor: const Color(0xFFF7F5F0),
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(12),
                  borderSide: BorderSide.none,
                ),
              ),
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: const Text('취소', style: TextStyle(color: Colors.grey)),
          ),
          ElevatedButton(
            style: ElevatedButton.styleFrom(
              backgroundColor: const Color(0xFF2E7D32),
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
            ),
            onPressed: () async {
              final w = wordController.text.trim();
              final m = meaningController.text.trim();
              if (w.isEmpty || m.isEmpty) return;

              Navigator.pop(ctx);
              try {
                await supabase.from('words').insert({
                  'book_id': widget.bookId,
                  'day': widget.day,
                  'word': w,
                  'meaning': m,
                });
                _fetchWords();
              } catch (e) {
                if (mounted) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(content: Text('단어 저장 실패: $e')),
                  );
                }
              }
            },
            child: const Text('저장', style: TextStyle(color: Colors.white)),
          ),
        ],
      ),
    );
  }

  Future<void> _deleteWord(int id) async {
    try {
      await supabase.from('words').delete().eq('id', id);
      _fetchWords();
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('삭제 실패: $e')),
        );
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text('${widget.bookTitle} · Day ${widget.day}'),
        actions: [
          IconButton(
            icon: const Icon(Icons.add, size: 28),
            tooltip: '단어 추가',
            onPressed: _showAddWordDialog,
          ),
        ],
      ),
      body: _isLoading
          ? const Center(child: CircularProgressIndicator(color: Color(0xFF2E7D32)))
          : _words.isEmpty
              ? Center(
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      const Text(
                        '등록된 단어가 없습니다.',
                        style: TextStyle(color: Color(0xFF78716C), fontSize: 16),
                      ),
                      const SizedBox(height: 20),
                      ElevatedButton.icon(
                        style: ElevatedButton.styleFrom(
                          backgroundColor: const Color(0xFF2E7D32),
                          foregroundColor: Colors.white,
                          padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 14),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(16),
                          ),
                          elevation: 2,
                        ),
                        onPressed: _showAddWordDialog,
                        icon: const Icon(Icons.add),
                        label: const Text(
                          '단어 추가하기',
                          style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
                        ),
                      ),
                    ],
                  ),
                )
              : ListView.separated(
                  padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                  itemCount: _words.length,
                  separatorBuilder: (context, index) => const Divider(
                    height: 1,
                    color: Color(0xFFE7E5E4),
                  ),
                  itemBuilder: (context, index) {
                    final item = _words[index];
                    return Card(
                      color: Colors.white,
                      elevation: 0.5,
                      margin: const EdgeInsets.symmetric(vertical: 4),
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(12),
                      ),
                      child: ListTile(
                        contentPadding: const EdgeInsets.symmetric(
                            horizontal: 16, vertical: 6),
                        title: Text(
                          item['word'] ?? '',
                          style: const TextStyle(
                            fontSize: 18,
                            fontWeight: FontWeight.bold,
                            color: Color(0xFF1C1917),
                          ),
                        ),
                        subtitle: Text(
                          item['meaning'] ?? '',
                          style: const TextStyle(
                            fontSize: 15,
                            color: Color(0xFF57534E),
                          ),
                        ),
                        trailing: IconButton(
                          icon: const Icon(Icons.close, color: Color(0xFFA8A29E)),
                          onPressed: () => _deleteWord(item['id']),
                        ),
                      ),
                    );
                  },
                ),
      floatingActionButton: FloatingActionButton(
        onPressed: _showAddWordDialog,
        backgroundColor: const Color(0xFF2E7D32),
        foregroundColor: Colors.white,
        tooltip: '단어 추가',
        child: const Icon(Icons.add),
      ),
      bottomNavigationBar: _words.length >= 4
          ? SafeArea(
              child: Padding(
                padding: const EdgeInsets.all(16.0),
                child: ElevatedButton.icon(
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF388E3C),
                    foregroundColor: Colors.white,
                    minimumSize: const Size.fromHeight(52),
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(16),
                    ),
                    elevation: 2,
                  ),
                  icon: const Icon(Icons.quiz),
                  label: Text(
                    'Day ${widget.day} 퀴즈 풀기 (${_words.length}단어)',
                    style: const TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
                  ),
                  onPressed: () {
                    Navigator.push(
                      context,
                      MaterialPageRoute(
                        builder: (_) => QuizScreen(
                          words: _words,
                          day: widget.day,
                        ),
                      ),
                    );
                  },
                ),
              ),
            )
          : null,
    );
  }
}

// ----------------------------------------------------
// 4. 4지선다 퀴즈 및 오답 재시험 화면
// ----------------------------------------------------
class QuizScreen extends StatefulWidget {
  final List<Map<String, dynamic>> words;
  final int day;

  const QuizScreen({
    super.key,
    required this.words,
    required this.day,
  });

  @override
  State<QuizScreen> createState() => _QuizScreenState();
}

class _QuizScreenState extends State<QuizScreen> {
  late List<Map<String, dynamic>> _quizList;
  int _currentIndex = 0;
  List<String> _currentOptions = [];
  String? _selectedOption;
  bool _isAnswered = false;
  int _score = 0;
  final List<Map<String, dynamic>> _wrongWords = [];

  @override
  void initState() {
    super.initState();
    _quizList = List.from(widget.words)..shuffle();
    _loadQuestion();
  }

  void _loadQuestion() {
    _isAnswered = false;
    _selectedOption = null;

    final currentWord = _quizList[_currentIndex];
    final correctAnswer = currentWord['meaning'] as String;

    final otherMeanings = widget.words
        .map((e) => e['meaning'] as String)
        .where((m) => m != correctAnswer)
        .toSet()
        .toList();

    otherMeanings.shuffle();
    final wrongOptions = otherMeanings.take(3).toList();

    final options = [correctAnswer, ...wrongOptions]..shuffle();
    setState(() {
      _currentOptions = options;
    });
  }

  void _selectOption(String option) {
    if (_isAnswered) return;

    final correctAnswer = _quizList[_currentIndex]['meaning'] as String;
    setState(() {
      _selectedOption = option;
      _isAnswered = true;
      if (option == correctAnswer) {
        _score++;
      } else {
        _wrongWords.add(_quizList[_currentIndex]);
      }
    });

    Future.delayed(const Duration(milliseconds: 900), () {
      if (!mounted) return;
      if (_currentIndex + 1 < _quizList.length) {
        setState(() {
          _currentIndex++;
        });
        _loadQuestion();
      } else {
        _showResult();
      }
    });
  }

  void _showResult() {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: Colors.white,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        title: const Text('🎉 퀴즈 완료!', style: TextStyle(fontWeight: FontWeight.bold)),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Text(
              '점수: $_score / ${_quizList.length}',
              style: const TextStyle(fontSize: 18, fontWeight: FontWeight.w600),
            ),
            if (_wrongWords.isNotEmpty) ...[
              const SizedBox(height: 12),
              Text(
                '틀린 단어: ${_wrongWords.length}개',
                style: const TextStyle(color: Colors.redAccent, fontWeight: FontWeight.bold),
              ),
            ]
          ],
        ),
        actions: [
          if (_wrongWords.isNotEmpty)
            TextButton(
              onPressed: () {
                Navigator.pop(ctx);
                setState(() {
                  _quizList = List.from(_wrongWords)..shuffle();
                  _wrongWords.clear();
                  _currentIndex = 0;
                  _score = 0;
                });
                _loadQuestion();
              },
              child: const Text(
                '틀린 단어 재시험',
                style: TextStyle(color: Color(0xFF2E7D32), fontWeight: FontWeight.bold),
              ),
            ),
          ElevatedButton(
            style: ElevatedButton.styleFrom(
              backgroundColor: const Color(0xFF2E7D32),
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
            ),
            onPressed: () {
              Navigator.pop(ctx);
              Navigator.pop(context);
            },
            child: const Text('종료', style: TextStyle(color: Colors.white)),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final currentWord = _quizList[_currentIndex];

    return Scaffold(
      appBar: AppBar(
        title: Text('Day ${widget.day} 테스트 (${_currentIndex + 1}/${_quizList.length})'),
      ),
      body: Padding(
        padding: const EdgeInsets.all(24.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            LinearProgressIndicator(
              value: (_currentIndex + 1) / _quizList.length,
              backgroundColor: const Color(0xFFE7E5E4),
              color: const Color(0xFF2E7D32),
            ),
            const Spacer(),
            Center(
              child: Text(
                currentWord['word'] ?? '',
                style: const TextStyle(
                  fontSize: 38,
                  fontWeight: FontWeight.bold,
                  letterSpacing: 1.2,
                  color: Color(0xFF1C1917),
                ),
              ),
            ),
            const Spacer(),
            ...List.generate(_currentOptions.length, (index) {
              final option = _currentOptions[index];
              Color btnColor = Colors.white;
              Color textColor = const Color(0xFF292524);

              if (_isAnswered) {
                final correctAnswer = currentWord['meaning'] as String;
                if (option == correctAnswer) {
                  btnColor = const Color(0xFF2E7D32);
                  textColor = Colors.white;
                } else if (option == _selectedOption) {
                  btnColor = Colors.redAccent;
                  textColor = Colors.white;
                }
              }

              return Padding(
                padding: const EdgeInsets.symmetric(vertical: 6.0),
                child: ElevatedButton(
                  style: ElevatedButton.styleFrom(
                    padding: const EdgeInsets.symmetric(vertical: 16),
                    backgroundColor: btnColor,
                    elevation: 1.5,
                    shadowColor: Colors.black12,
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(16),
                    ),
                  ),
                  onPressed: () => _selectOption(option),
                  child: Text(
                    option,
                    style: TextStyle(
                      fontSize: 17,
                      color: textColor,
                      fontWeight: FontWeight.w600,
                    ),
                  ),
                ),
              );
            }),
            const SizedBox(height: 20),
          ],
        ),
      ),
    );
  }
}
