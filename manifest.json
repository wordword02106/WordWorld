import 'package:flutter/material.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

void main() async {
  WidgetsFlutterBinding.ensureInitialized();

  // Supabase 통신 설정 (anonKey 유지)
  await Supabase.initialize(
    url: 'https://vugtxfchdtyjcvqgphse.supabase.co',
    anonKey: 'sb_publishable_sQ1_sH_CynqU3127Hk35fA_ZpP3U0t1',
  );

  runApp(const WordWorldApp());
}

final supabase = Supabase.instance.client;

class WordWorldApp extends StatelessWidget {
  const WordWorldApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'WordWorld',
      theme: ThemeData(
